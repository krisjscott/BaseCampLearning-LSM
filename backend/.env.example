# Server
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3001
FRONTEND_URL=http://localhost:3100

# Cloudflare Turnstile
TURNSTILE_SECRET=
TURNSTILE_ENABLED=false

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (leave blank to use local ./uploads storage)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=basecamp-videos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT
JWT_SECRET=replace-with-a-base64-encoded-secret
JWT_EXPIRATION=86400000

# Optional first production start only; remove the password after bootstrap.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Platform Administrator

# Database (cloud/dev/prod profile)
DB_URL=jdbc:postgresql://host/database?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
