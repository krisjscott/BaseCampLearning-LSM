# Server
SERVER_PORT=8081

# Cloudflare Turnstile
TURNSTILE_SECRET=
TURNSTILE_ENABLED=false

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail (SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT
JWT_SECRET=replace-with-a-base64-encoded-secret

# Database (cloud/dev/prod profile)
DB_URL=jdbc:postgresql://host/database?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Local (H2) profile
LOCAL_DB_URL=jdbc:h2:file:./data/basecamp-local;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
LOCAL_DB_USERNAME=sa
LOCAL_DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
